{
  "version": "1.0.0",
  "analysis": {
    "max_file_size_mb": 256,
    "entropy_threshold": 7.0,
    "min_string_length": 6,
    "max_strings_extracted": 50000,
    "enable_dynamic_emulation": true,
    "emulation_timeout_ms": 5000,
    "emulation_max_instructions": 500000,
    "scan_access_control_patterns": true,
    "detect_packers": true,
    "verify_checksums": true
  },
  "access_control_patterns": {
    "license_keywords": [
      "license", "licence", "serial", "activation", "register",
      "trial", "expired", "valid", "invalid", "key", "hwid",
      "hardware id", "machine id", "product key", "subscription"
    ],
    "auth_api_patterns": [
      "CryptAcquireContext", "CryptEncrypt", "CryptDecrypt",
      "CryptHashData", "BCrypt", "NCrypt", "RegOpenKey",
      "RegQueryValue", "GetVolumeInformation", "GetAdaptersInfo",
      "GetComputerName", "IsDebuggerPresent", "CheckRemoteDebuggerPresent",
      "NtQueryInformationProcess", "CreateMutex", "OpenMutex",
      "InternetOpen", "HttpSendRequest", "WinHttpConnect",
      "URLDownloadToFile", "CreateProcess", "ShellExecute"
    ],
    "registry_paths": [
      "SOFTWARE\\\\", "CurrentVersion\\\\Run", "AppData\\\\",
      "Classes\\\\", "MachineGuid", "ProductId"
    ]
  },
  "risk_scoring": {
    "unsigned_binary": 15,
    "high_entropy_section": 20,
    "minimal_imports": 25,
    "suspicious_section_names": 20,
    "access_control_detected": 10,
    "debugger_checks": 15,
    "network_callbacks": 20,
    "process_injection_apis": 30
  },
  "output": {
    "formats": ["json", "markdown"],
    "include_raw_strings": false,
    "include_disassembly_preview": true,
    "disassembly_instruction_count": 64,
    "report_directory": "reports"
  },
  "logging": {
    "level": "INFO",
    "log_file": "logs/audit.log",
    "console_output": true,
    "structured_json_logs": false
  },
  "unpack_emulator": {
    "timeout_ms": 30000,
    "max_instructions": 2000000,
    "max_dump_bytes": 4096,
    "max_dump_regions": 32,
    "hook_api_calls": true,
    "capture_on_virtualprotect_rx": true,
    "capture_on_bulk_write": true,
    "bulk_write_threshold": 4096,
    "attempt_static_decrypt": true,
    "output": {
      "directory": "unpack_artifacts",
      "write_memory_dumps": true,
      "write_import_table": true,
      "write_json_report": true,
      "write_markdown_report": true,
      "formats": ["json", "markdown", "bin"]
    },
    "logging": {
      "level": "INFO",
      "log_file": "logs/unpack_emulator.log",
      "console_output": true
    }
  },
  "integrity_patch_emulator": {
    "max_branch_sites": 50,
    "max_patches_apply": 10,
    "run_brief_emulation": true,
    "brief_emulation_instructions": 50000,
    "export_full_pe_reconstruction": true,
    "export_text_section": true,
    "export_raw_regions": true,
    "output": {
      "directory": "patch_artifacts",
      "write_json_report": true,
      "write_markdown_report": true,
      "write_memory_dumps": true,
      "write_edr_indicators": true
    },
    "logging": {
      "level": "INFO",
      "log_file": "logs/patch_emulator.log",
      "console_output": true
    }
  },
  "unified_pipeline": {
    "output_directory": "patch_artifacts",
    "run_phase1": true,
    "run_phase2": true,
    "run_phase3": true,
    "run_phase4": true,
    "logging": {
      "level": "INFO",
      "log_file": "logs/pipeline.log",
      "console_output": true
    }
  },
  "ci_validation": {
    "wine_prefix": "/tmp/defensive-audit-wine-prefix",
    "wine_timeout_sec": 20,
    "main_loop_survival_sec": 5.0,
    "require_wine": false,
    "output_subdirectory": "ci_reports"
  }
}
